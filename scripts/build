#!/usr/bin/env bash

set -exuo pipefail

cd "$(dirname "$0")/.."

node scripts/utils/sync-version.cjs

# Bundle CJS + ESM + type declarations into dist/ (published via package.json "files")
./node_modules/.bin/tsup

# make sure that nothing crashes when we require the output CJS or import the output ESM
node -e 'require("./dist/index.js")'
node -e 'import("./dist/index.mjs")' --input-type=module
