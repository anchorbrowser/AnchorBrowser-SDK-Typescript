        percentage?: number;
        /**
         * Current processing phase
         */
        current_phase?: 'queued' | 'provisioning' | 'configuring' | 'ready';
    };
};
type BatchSessionListItemSchema = {
    /**
     * Unique identifier for the batch
     */
    batch_id?: string;
    /**
     * Current status of the batch
     */
