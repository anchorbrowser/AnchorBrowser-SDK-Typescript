        [key: string]: unknown;
    };
};
/**
 * async
 */
type PerformWebTaskAsyncResponseData = {
    /**
     * The status of the asynchronous task execution.
     */
    status: 'running';
    /**
     * The workflow ID for tracking the asynchronous task execution.
     */
