};
type PerformWebTaskResponseSchema = {
    data?: PerformWebTaskSyncResponseData | PerformWebTaskAsyncResponseData;
};
/**
 * success
 */
type PerformWebTaskStatusSuccessResponseData = {
    /**
     * The workflow has completed successfully.
     */
