    /**
     * The outcome or answer produced by the autonomous task.
     */
    result: {
        [key: string]: unknown;
    };
};
/**
 * running
 */
type PerformWebTaskStatusRunningResponseData = {
    /**
     * The workflow is currently running.
     */
    status: 'RUNNING';
};
/**
 * failed
 */
type PerformWebTaskStatusFailedResponseData = {
    /**
     * The workflow has failed.
     */
    status: 'FAILED';
    /**
     * Error message describing why the workflow failed.
     */
    error: string;
};
type PerformWebTaskStatusResponseSchema = {
    data: PerformWebTaskStatusSuccessResponseData | PerformWebTaskStatusRunningResponseData | PerformWebTaskStatusFailedResponseData;
};
type HumanInterventionField = {
