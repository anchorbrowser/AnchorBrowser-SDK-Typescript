{
  "name": "anchorbrowser",
  "version": "1.0.0",
  "description": "The official TypeScript library for the Anchorbrowser API",
  "author": "Anchorbrowser <support@anchorbrowser.io>",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "type": "commonjs",
  "repository": "github:anchorbrowser/AnchorBrowser-SDK-Typescript",
  "license": "Apache-2.0",
  "packageManager": "yarn@1.22.22",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "anchorbrowser",
    "anchor",
    "browser",
    "automation",
    "infrastructure",
    "agentic-browser",
    "sdk",
    "typescript",
    "browser-automation",
    "agent-api",
    "ai-agents",
    "automation-infra",
    "cloud-browser",
    "self-healing",
    "cdp",
    "playwright",
    "browser-agents",
    "proxy",
    "captcha-bypass",
    "web-scraping",
    "form-filling",
    "session-management",
    "enterprise-security",
    "browser-infrastructure",
    "autonomous-web"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "./scripts/test",
    "build": "./scripts/build",
    "format": "./scripts/format",
    "lint": "./scripts/lint",
    "fix": "./scripts/format",
    "api:update": "node scripts/utils/api-surface.cjs --update && api-extractor run --local",
    "api:check": "node scripts/utils/api-surface.cjs --check && api-extractor run",
    "generate": "node scripts/utils/prepare-spec.cjs && openapi-ts && prettier --write src/generated/ spec/openapi-sdk.yaml",
    "generate:check": "yarn generate && git diff --exit-code -- src/generated/ spec/openapi-sdk.yaml"
  },
  "dependencies": {
    "playwright": "^1.57.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@microsoft/api-extractor": "^7.58.11",
    "@swc/core": "^1.3.102",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.4.0",
    "@types/node": "^20.19.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.4.0",
    "prettier": "^3.0.0",
    "publint": "^0.2.12",
    "ts-jest": "^29.1.0",
    "tsup": "^8.3.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "minimatch": "^9.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^9.0.5"
    }
  },
  "resolutions": {
    "minimatch": "^9.0.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
